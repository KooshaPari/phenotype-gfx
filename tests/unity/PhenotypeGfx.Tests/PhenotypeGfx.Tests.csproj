<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>true</GenerateProgramFile>
    <RootNamespace>PhenotypeGfx.Tests</RootNamespace>
    <AssemblyName>PhenotypeGfx.Tests</AssemblyName>
    <!--
      The Unity wrapper lives in unity/PhenotypeGfx.cs and is *not* included
      here on purpose: that wrapper uses [DllImport("phenotype_gfx")] which
      requires the native cdylib at runtime, plus real UnityEngine types
      (Vector3/Vector2/Mesh) that we can't ship from CI. Instead the test
      project compiles a parallel "MockNative"-backed wrapper that mirrors
      the public API surface 1:1, so the test cases double as a behavioural
      spec for the FFI contract.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Note: .cs files under this project directory (Stubs/, Mocks/, and the
    *Tests.cs fixtures) are auto-included by the SDK; we deliberately do
    NOT re-list them as <Compile /> items.
  -->

</Project>
