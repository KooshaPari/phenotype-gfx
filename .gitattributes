# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Rust sources
*.rs text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# YAML
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Deny false positives on governance files
LICENSE-APACHE binary
LICENSE-MIT binary
